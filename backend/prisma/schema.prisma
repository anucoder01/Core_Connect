generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  role          String    @default("EMPLOYEE") // EMPLOYER, EMPLOYEE
  department    String?
  position      String?
  salary        Float?
  skills        String?   // Comma-separated list of technical/domain skills
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // HR relations
  leaves        LeaveRequest[]
  pulseChecks   PulseCheck[]
  assignedTasks Task[]
  notifications Notification[]
  timeEntries   TimeEntry[]

  // CRM relations
  managedLeads  Lead[]
  auditEvents   AuditLog[] @relation("AuditActor")
}

model Lead {
  id                String      @id @default(uuid())
  name              String
  company           String
  email             String
  status            String      @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL, WON, LOST
  value             Float?
  priority          String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  expectedCloseDate DateTime?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Assigned to an employee/employer
  assigneeId        String?
  assignee          User?       @relation(fields: [assigneeId], references: [id])

  clientFeedbacks   ClientFeedback[]
  timeEntries       TimeEntry[]

  @@index([assigneeId, status])
  @@index([expectedCloseDate])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  type            String      // Sick, Casual, Annual, etc.
  fromDate        DateTime
  toDate          DateTime
  reason          String
  status          String      @default("PENDING") // PENDING, APPROVED, REJECTED
  riskScore       String      @default("LOW") // LOW, MEDIUM, HIGH
  riskNotes       String?     // E.g. "Overlaps with 2 high-priority deals ($135,000)"
  coverageUserId  String?     // Suggested peer colleague for handoff
  createdAt       DateTime    @default(now())

  userId          String
  user            User        @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([fromDate, toDate])
}

model PulseCheck {
  id            String      @id @default(uuid())
  score         Int         // 1 to 5
  workloadRisk  String      @default("MANAGEABLE") // LIGHT, MANAGEABLE, HIGH, BURNOUT
  feedback      String?
  type          String      @default("EMPLOYEE") // EMPLOYEE or CLIENT
  createdAt     DateTime    @default(now())

  userId        String?
  user          User?       @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([workloadRisk, createdAt])
}

model Task {
  id            String      @id @default(uuid())
  title         String
  description   String?
  clientName    String?     // Tied to a CRM client
  priority      String      @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status        String      @default("TODO") // TODO, IN_PROGRESS, DONE
  dueDate       DateTime?
  createdAt     DateTime    @default(now())

  assigneeId    String
  assignee      User        @relation(fields: [assigneeId], references: [id])

  @@index([assigneeId, status])
  @@index([dueDate, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // ALERT, LEAD, LEAVE, BURNOUT, SYSTEM, TASK
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model ClientFeedback {
  id          String   @id @default(uuid())
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientName  String
  company     String
  score       Int      // 1 to 5 rating
  npsCategory String   @default("PROMOTER") // PROMOTER, PASSIVE, DETRACTOR
  category    String   @default("Delivery") // Delivery, Technical Quality, Communication
  feedback    String?
  createdAt   DateTime @default(now())

  @@index([leadId, createdAt])
  @@index([score, createdAt])
}

model TimeEntry {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  hours       Float
  date        DateTime @default(now())
  description String?
  billable    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId, date])
  @@index([leadId, date])
}
